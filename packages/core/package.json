{
  "name": "@openlinkos/origin-core",
  "version": "0.4.0",
  "description": "Origin core: append-only raw mirror, unified event store, search and timeline (no LLM calls).",
  "keywords": [
    "origin",
    "openlinkos",
    "sqlite",
    "memory",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "OpenLinkOS",
  "homepage": "https://github.com/openlinkos/origin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlinkos/origin.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/openlinkos/origin/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
