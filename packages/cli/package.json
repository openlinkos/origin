{
  "name": "@openlinkos/origin",
  "version": "0.3.0",
  "description": "The `origin` command: sync, search, and curate your AI agent memory locally, and serve it to agents over MCP.",
  "keywords": [
    "origin",
    "openlinkos",
    "mcp",
    "ai-agents",
    "memory",
    "claude-code",
    "codex",
    "cli",
    "local-first"
  ],
  "license": "MIT",
  "author": "OpenLinkOS",
  "homepage": "https://github.com/openlinkos/origin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlinkos/origin.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/openlinkos/origin/issues"
  },
  "type": "module",
  "bin": {
    "origin": "./dist/bin.js"
