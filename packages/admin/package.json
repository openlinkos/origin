{
  "name": "@openlinkos/origin-admin",
  "version": "0.1.0",
  "description": "Origin admin UI: a server-rendered web interface for the owner of a self-hosted Origin hub.",
  "keywords": [
    "origin",
    "openlinkos",
    "admin",
    "dashboard"
  ],
  "license": "MIT",
  "author": "OpenLinkOS",
  "homepage": "https://github.com/openlinkos/origin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlinkos/origin.git",
    "directory": "packages/admin"
  },
  "bugs": {
    "url": "https://github.com/openlinkos/origin/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "!dist/**/*.map",
    "!dist/**/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/vendor.mjs"
  },
  "dependencies": {
    "@openlinkos/origin-core": "workspace:*"
  },
  "devDependencies": {
    "@openlinkos/ui": "0.2.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
