{
  "name": "@openlinkos/origin-adapters",
  "version": "0.2.0",
  "description": "Origin source adapters: deterministic parsers for local AI agent session logs.",
  "keywords": [
    "origin",
    "openlinkos",
    "claude-code",
    "codex",
    "session-logs"
  ],
  "license": "MIT",
  "author": "OpenLinkOS",
  "homepage": "https://github.com/openlinkos/origin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlinkos/origin.git",
    "directory": "packages/adapters"
  },
  "bugs": {
    "url": "https://github.com/openlinkos/origin/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@openlinkos/origin-core": "workspace:*"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
