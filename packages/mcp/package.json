{
  "name": "@openlinkos/origin-mcp",
  "version": "0.4.0",
  "description": "Origin MCP server (stdio): search, timeline, sources, and remember/correct/forget for any MCP-capable agent.",
  "keywords": [
    "origin",
    "openlinkos",
    "mcp",
    "model-context-protocol",
    "memory"
  ],
  "license": "MIT",
  "author": "OpenLinkOS",
  "homepage": "https://github.com/openlinkos/origin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlinkos/origin.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/openlinkos/origin/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openlinkos/origin-core": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
